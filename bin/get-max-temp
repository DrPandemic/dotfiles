#!/usr/bin/env ruby

require 'json'

FRIENDLY_NAMES = {
  'acpitz' => 'ACPI Thermal Zone',
  'nvme' => 'NVMe SSD',
  'k10temp' => 'AMD CPU',
  'gigabyte_wmi' => 'Gigabyte MB',
}

FRIENDLY_NAMES_PATTERN = {
  /\Ar8169/ => 'Realtek Ethernet',
  /\Amt7925/ => 'MediaTek WiFi',
}

def resolve_amdgpu_name(hwmon_dir)
  pci_addr = File.basename(File.readlink(File.join(hwmon_dir, 'device')))
  lspci_line = `lspci -s #{pci_addr} 2>/dev/null`.strip
  if lspci_line.include?('Radeon RX')
    model = lspci_line[/Radeon RX \S+/] || 'Discrete GPU'
    model
  elsif lspci_line.include?('Radeon Graphics')
    'iGPU'
  else
    'AMD GPU'
  end
rescue
  'AMD GPU'
end

def friendly_name(hardware_name, hwmon_dir)
  return resolve_amdgpu_name(hwmon_dir) if hardware_name == 'amdgpu'
  return FRIENDLY_NAMES[hardware_name] if FRIENDLY_NAMES.key?(hardware_name)

  FRIENDLY_NAMES_PATTERN.each do |pattern, name|
    return name if hardware_name.match?(pattern)
  end

  hardware_name
end

# Find all hwmon directories
hwmon_dirs = Dir.glob('/sys/class/hwmon/hwmon*').sort

# Same order as the board's fan headers in the it87 sensors config for the X870 EAGLE WIFI7.
SIO_FANS = %w[cpu_fan sys_fan1 sys_fan2 sys_fan3 cpu_fan sys_fan4]

max_temp = 0
temperatures = []
fans = Hash.new { |h, k| h[k] = [] }

hwmon_dirs.each do |hwmon_dir|
  name_file = File.join(hwmon_dir, 'name')

  # Skip if name file doesn't exist
  next unless File.exist?(name_file)

  # Read hardware name
  hardware_name = File.read(name_file).strip
  display_name = friendly_name(hardware_name, hwmon_dir)

  Dir.glob(File.join(hwmon_dir, 'fan*_input')).each do |fan_file|
    n = File.basename(fan_file)[/\d+/].to_i
    series = hardware_name == 'amdgpu' ? 'gpu_fan' : (SIO_FANS[n - 1] if hardware_name.start_with?('it8696'))
    fans[series] << File.read(fan_file).to_i if series
  end
  # Mirrors gigabyte_wmi's readings, which already cover these.
  next if hardware_name.start_with?('it8696')

  # Find all temperature input files (temp1_input, temp2_input, etc.)
  temp_files = Dir.glob(File.join(hwmon_dir, 'temp*_input')).sort

  temp_files.each do |temp_file|
    temp_millicelsius = File.read(temp_file).strip.to_i
    temp_celsius = temp_millicelsius / 1000

    # Create unique key for each temperature sensor
    temp_number = File.basename(temp_file).match(/temp(\d+)_input/)[1]
    key = temp_files.length > 1 ? "#{hardware_name}_temp#{temp_number}" : hardware_name
    label = temp_files.length > 1 ? "#{display_name} #{temp_number}" : display_name

    # Exclude GPU memory and network cards from max calculation
    exclude_from_max = key == "amdgpu_temp3" ||
      hardware_name.match?(/\Ar8169/) ||
      hardware_name.match?(/\Amt7925/)
    max_temp = [max_temp, temp_celsius].max unless exclude_from_max

    temperatures << { key: key, label: label, temp: temp_celsius }
  end
end

HISTORY = File.join(ENV['XDG_RUNTIME_DIR'] || '/tmp', 'temp-history.jsonl')
HISTORY_EVERY_SECS = 25
HISTORY_SERIES = {
  'k10temp_temp1' => 'cpu',
  'amdgpu_temp1' => 'gpu',
  'amdgpu_temp2' => 'gpu_hot',
  'amdgpu_temp3' => 'vram',
  'nvme_temp1' => 'nvme',
}

# One waybar per output runs this concurrently, hence the lock; a file last written before boot is a previous boot's history.
def log_history(temperatures, fans)
  boot = File.foreach('/proc/stat').find { |l| l.start_with?('btime ') }.split[1].to_i
  File.open(HISTORY, File::WRONLY | File::APPEND | File::CREAT) do |f|
    f.flock(File::LOCK_EX)
    f.truncate(0) if f.mtime.to_i < boot
    return if f.size.positive? && Time.now - f.mtime < HISTORY_EVERY_SECS

    row = { 't' => Time.now.to_i }
    temperatures.each { |e| row[HISTORY_SERIES[e[:key]]] = e[:temp] if HISTORY_SERIES.key?(e[:key]) }
    fans.each do |series, rpms|
      spinning = rpms.select(&:positive?)
      row[series] = spinning.empty? ? 0 : (spinning.sum.to_f / spinning.size).round
    end
    f.puts JSON.generate(row)
  end
rescue SystemCallError
  nil
end

log_history(temperatures, fans)

SORT_ORDER = {
  'k10temp' => 0,
  'amdgpu' => 1,
}

temperatures.sort_by! do |entry|
  base_name = entry[:key].sub(/_temp\d+$/, '')
  [SORT_ORDER.fetch(base_name, 99), entry[:key]]
end

# Format output
formatted_temps = ""
temperatures.each do |entry|
  formatted_temps << "#{entry[:label]} (#{entry[:key]} : #{entry[:temp]}°C)\r"
end
formatted_temps = formatted_temps[0...-1] unless formatted_temps.empty?

puts([max_temp, formatted_temps].join("\n"))
