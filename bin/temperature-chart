#!/usr/bin/env sh
# Toggles the temperature chart popup on the focused output.

config="$(dirname "$(readlink -f "$0")")/../quickshell/temperature"

if ! qs list -p "$config" 2>&1 | grep -q "No running instances"; then
  qs kill -p "$config"
else
  TEMP_SCREEN="$(swaymsg -t get_outputs | jq -r '.[] | select(.focused) | .name')" qs -p "$config" -d
fi
